# Canlı sunum ve QR kodları için temel alan adı (sonda / olmadan)
# Bu değer Next.js üretim derlemesi (next build) sırasında istemci paketine işlenir.
NEXT_PUBLIC_PRESENTATION_BASE_URL=https://menu.prilmones.com.tr

# Sunucuda uygulamanın 127.0.0.1 üzerinde dinleyeceği boş host portu
# Örnek değil — sunucuda `ss -tulpn` ile boş olduğunu doğruladığınız bir port numarası yazın.
APP_PORT=
