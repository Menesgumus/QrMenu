# menu.prilmones.com.tr — Üretim Önbellek ve Sıkıştırma Önerisi (Örnek Dosya)
# NOT: Bu dosya yalnızca referans amaçlıdır; uzak sunucuya otomatik uygulanmaz.
# Mevcut Pril Masası site yapılandırmalarına dokunulmamalıdır.
# Kurulum öncesi <APP_PORT> değerini sunucuda doğrulanmış localhost portu ile değiştirin.

server {
    listen 80;
    listen [::]:80;
    server_name menu.prilmones.com.tr;

    # Metin tabanlı varlıklar için Nginx sıkıştırması (WebP/WOFF2 zaten sıkıştırılmış olduğundan hariç tutulur)
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        image/svg+xml;

    # 1. Next.js içerik hash'li statik JS / CSS / font varlıkları -> 1 yıl immutable (yalnızca 200 vb. başarı yanıtları; `always` kullanılmaz)
    location ^~ /_next/static/ {
        proxy_pass http://127.0.0.1:<APP_PORT>;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # 2. Yalnızca dosya adında doğrulanmış içerik hash'i taşıyan menü görselleri -> 1 yıl immutable
    # Örnek: /images/menu/hashed/card/truflu-yumurta.a1b2c3d4.webp
    # Geçiş uyumluluğu: compose.yaml `qrmenu_hashed_assets` kalıcı birimiyle son N (`HASHED_ASSET_KEEP_RELEASES=2`)
    # sürümün hash'li dosyaları tutulur; süresi dolan veya geçersiz hash'lerde Next.js 404 döner
    # ve `always` olmadığı için 404 yanıtları `immutable` olarak önbelleğe alınmaz.
    location ^~ /images/menu/hashed/ {
        proxy_pass http://127.0.0.1:<APP_PORT>;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # 3. Hash'siz doğrudan /images/menu/<variant>/<slug>.webp yolları (eski HTML / geri uyumluluk)
    # Kısa süreli önbellek: eski fotoğrafın uzun süre kalmasını önler, tekrar yüklerde 304/SWR sağlar.
    location ^~ /images/menu/ {
        proxy_pass http://127.0.0.1:<APP_PORT>;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        expires 1h;
        add_header Cache-Control "public, max-age=3600, stale-while-revalidate=86400";
    }

    # 4. Menü HTML sayfaları (/, /m/[slug]) ve diğer dinamik rotalar
    # ÖNEMLİ: Görsel cache politikası buraya ASLA uygulanmaz; upstream no-store/no-cache başlığı korunur.
    location / {
        proxy_pass http://127.0.0.1:<APP_PORT>;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
